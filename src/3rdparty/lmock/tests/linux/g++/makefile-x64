######################################################################
# PCL Mock Test Suite
# Platform: Linux/g++ x64
######################################################################

OBJ_DIR=$(PCLSRCDIR)/3rdparty/lmock/tests/linux/g++/x64/Release

# BackgroundExtraction module object directory
BG_OBJ_DIR=$(PCLSRCDIR)/modules/processes/contrib/jkimmitt/backgroundextraction/linux/g++/x64/Release
BG_SRC_DIR=$(PCLSRCDIR)/modules/processes/contrib/jkimmitt/backgroundextraction

# LocalHistogramEqualization module
LHE_OBJ_DIR=$(PCLSRCDIR)/modules/processes/contrib/zvrastil/LocalHistogramEqualization/linux/g++/x64/Release
LHE_SRC_DIR=$(PCLSRCDIR)/modules/processes/contrib/zvrastil/LocalHistogramEqualization

.PHONY: all
all: $(OBJ_DIR)/test_fft $(OBJ_DIR)/test_bgextraction $(OBJ_DIR)/test_stretch $(OBJ_DIR)/test_realdata $(OBJ_DIR)/xisf_wcs $(OBJ_DIR)/xisf_snr $(OBJ_DIR)/galaxy_processor

#
# Compiler/linker flags
#

CXX = g++
QT5_CXXFLAGS = $(shell pkg-config --cflags Qt5Core Qt5Widgets Qt5Gui Qt5Svg Qt5Concurrent 2>/dev/null)
QT5_LIBS = $(shell pkg-config --libs Qt5Core Qt5Widgets Qt5Gui Qt5Svg Qt5Concurrent 2>/dev/null)

#
# Build mode: DEBUG=1 for sanitizers + debug info, default is release
#

COMMON_CXXFLAGS = -c -pipe -pthread -m64 -fPIC \
	-D_REENTRANT -D__PCL_LINUX -D__PCL_NO_PERFORMANCE_CRITICAL_MATH_ROUTINES \
	-I"$(PCLINCDIR)" -I"$(PCLSRCDIR)/3rdparty" \
	$(QT5_CXXFLAGS) \
	-ffunction-sections -fdata-sections -fvisibility=default \
	-std=c++17 \
	-Wall -Wno-parentheses \
	-MMD -MP

COMMON_LDFLAGS = -m64 -fPIC -pthread \
	-Wl,-fuse-ld=gold -Wl,--enable-new-dtags -Wl,-z,noexecstack \
	-Wl,-O1 -Wl,--gc-sections \
	-Wl,--allow-multiple-definition \
	-rdynamic \
	-L"$(PCLLIBDIR64)" \
	-L"$(PCLSRCDIR)/pcl/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/lz4/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/zstd/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/zlib/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/RFC6234/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/lcms/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/cminpack/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/3rdparty/lmock/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/modules/file-formats/XISF/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/modules/file-formats/FITS/linux/g++/x64/Release" \
	-L"$(PCLSRCDIR)/modules/file-formats/TIFF/linux/g++/x64/Release"

ifdef DEBUG
CXXFLAGS = $(COMMON_CXXFLAGS) -O0 -g -fsanitize=address
LDFLAGS  = $(COMMON_LDFLAGS) -fsanitize=address
else
CXXFLAGS = $(COMMON_CXXFLAGS) -O3 -DNDEBUG -mavx2 -mfma
LDFLAGS  = $(COMMON_LDFLAGS)
endif

LIBS = -lpthread \
	-Wl,--start-group \
	-lPCL-pxi -llz4-pxi -lzstd-pxi -lzlib-pxi -lRFC6234-pxi \
	-llcms-pxi -lcminpack-pxi -lMock-pxi -lXISF-pxm -lFITS-pxm -lTIFF-pxm \
	-Wl,--end-group \
	-lfftw3 -lfftw3_threads \
	$(QT5_LIBS)

#
# Dependency files
#

DEP_FILES= \
./x64/Release/test_fft.d \
./x64/Release/test_bgextraction.d \
./x64/Release/test_stretch.d \
./x64/Release/test_realdata.d \
./x64/Release/xisf_wcs.d \
./x64/Release/xisf_snr.d \
./x64/Release/gp_wcs.d \
./x64/Release/gp_plate_solver.d \
./x64/Release/gp_color_calibration.d \
./x64/Release/gp_stretch.d \
./x64/Release/gp_histogram.d \
./x64/Release/gp_survey.d \
./x64/Release/gp_stacking.d \
./x64/Release/gp_lua.d \
./x64/Release/gp_pcl_modules.d \
./x64/Release/galaxy_processor_main.d \
./x64/Release/stackengine_cli.d

-include $(DEP_FILES)

#
# FFT test
#

$(OBJ_DIR)/test_fft: ./x64/Release/test_fft.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LIBS)
	@echo "Built: $@"

#
# Background Extraction test
# Links against pre-built BackgroundExtraction module .o files
#

BG_OBJS = \
	$(BG_OBJ_DIR)/BackgroundExtractor.o \
	$(BG_OBJ_DIR)/BackgroundExtractionInstance.o \
	$(BG_OBJ_DIR)/BackgroundExtractionInterface.o \
	$(BG_OBJ_DIR)/BackgroundExtractionParameters.o \
	$(BG_OBJ_DIR)/BackgroundExtractionProcess.o

$(OBJ_DIR)/test_bgextraction: ./x64/Release/test_bgextraction.o $(BG_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $< $(BG_OBJS) $(LIBS)
	@echo "Built: $@"

#
# Stretch test
#

$(OBJ_DIR)/test_stretch: ./x64/Release/test_stretch.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LIBS)
	@echo "Built: $@"

#
# Real data regression test
# Links against BackgroundExtraction module .o files
# Needs FITS module headers for FITSReader
#

LHE_OBJS = \
	$(LHE_OBJ_DIR)/LocalHistogramEqualizationInstance.o \
	$(LHE_OBJ_DIR)/LocalHistogramEqualizationInterface.o \
	$(LHE_OBJ_DIR)/LocalHistogramEqualizationParameters.o \
	$(LHE_OBJ_DIR)/LocalHistogramEqualizationProcess.o

$(OBJ_DIR)/test_realdata: ./x64/Release/test_realdata.o $(BG_OBJS) $(LHE_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $< $(BG_OBJS) $(LHE_OBJS) $(LIBS) -lpng
	@echo "Built: $@"

#
# XISF WCS inspector
#

$(OBJ_DIR)/xisf_wcs: ./x64/Release/xisf_wcs.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LIBS)
	@echo "Built: $@"

#
# XISF S/N metrics tool
#

$(OBJ_DIR)/xisf_snr: ./x64/Release/xisf_snr.o
	$(CXX) $(LDFLAGS) -o $@ $< $(LIBS)
	@echo "Built: $@"

#
# Galaxy Processor pipeline (requires OpenCV + cfitsio + stellarsolver)
#

STELLARSOLVER_CXXFLAGS = $(shell pkg-config --cflags stellarsolver 2>/dev/null || echo "-I/usr/include/libstellarsolver")
STELLARSOLVER_LIBS = $(shell pkg-config --libs stellarsolver 2>/dev/null || echo "-lstellarsolver")

FITSSTACKER_DIR = $(PCLSRCDIR)/3rdparty/lmock/tests/fitsstacker
GP_DIR = $(PCLSRCDIR)/3rdparty/lmock/tests/galaxy_processor
OPENCV_CXXFLAGS = $(shell pkg-config --cflags opencv4)
OPENCV_LIBS = -lopencv_core -lopencv_imgproc
CFITSIO_CXXFLAGS = $(shell pkg-config --cflags cfitsio)
CFITSIO_LIBS = $(shell pkg-config --libs cfitsio)
STACK_CXXFLAGS = $(OPENCV_CXXFLAGS) $(CFITSIO_CXXFLAGS) -I"$(FITSSTACKER_DIR)"
STACK_LIBS = $(OPENCV_LIBS) $(CFITSIO_LIBS)
STACK_OBJ = ./x64/Release/stackengine_cli.o

LUA_DIR = $(GP_DIR)/lua
SOL_DIR = $(GP_DIR)/sol2
LUA_CXXFLAGS = -I"$(LUA_DIR)" -I"$(SOL_DIR)"
LUA_LIB = $(LUA_DIR)/liblua54.a
LUA_LIBS = $(LUA_LIB) -lm -ldl

GP_CXXFLAGS = $(CXXFLAGS) $(STELLARSOLVER_CXXFLAGS) $(STACK_CXXFLAGS) $(LUA_CXXFLAGS) -I"$(GP_DIR)" -I"$(BG_SRC_DIR)" -I"$(LHE_SRC_DIR)" -I"$(PCLSRCDIR)/modules/file-formats"

MOC = moc

GP_OBJ = \
	./x64/Release/gp_wcs.o \
	./x64/Release/gp_plate_solver.o \
	./x64/Release/gp_color_calibration.o \
	./x64/Release/gp_stretch.o \
	./x64/Release/gp_histogram.o \
	./x64/Release/gp_survey.o \
	./x64/Release/gp_stacking.o \
	./x64/Release/gp_lua.o \
	./x64/Release/gp_pcl_modules.o \
	./x64/Release/gp_gui.o \
	./x64/Release/moc_gp_gui.o \
	./x64/Release/galaxy_processor_main.o

$(LUA_LIB):
	cd $(LUA_DIR) && gcc -c -O2 -DLUA_USE_POSIX -DLUA_USE_DLOPEN \
		lapi.c lauxlib.c lbaselib.c lcode.c lcorolib.c lctype.c ldblib.c \
		ldebug.c ldo.c ldump.c lfunc.c lgc.c linit.c liolib.c llex.c \
		lmathlib.c lmem.c loadlib.c lobject.c lopcodes.c loslib.c \
		lparser.c lstate.c lstring.c lstrlib.c ltable.c ltablib.c \
		ltm.c lundump.c lutf8lib.c lvm.c lzio.c && \
	ar rcs liblua54.a *.o && rm -f *.o
	@echo "Built Lua 5.4 static library"

$(OBJ_DIR)/galaxy_processor: $(GP_OBJ) $(STACK_OBJ) $(LUA_LIB)
	$(CXX) $(LDFLAGS) -Wl,-rpath,/usr/local/lib -o $@ $(GP_OBJ) $(STACK_OBJ) $(STACK_LIBS) $(LIBS) $(STELLARSOLVER_LIBS) $(LUA_LIBS)
	@echo "Built: $@"

./x64/Release/stackengine_cli.o: $(FITSSTACKER_DIR)/stackengine_cli.cpp $(FITSSTACKER_DIR)/stackengine.cpp $(FITSSTACKER_DIR)/stackengine.h
	@mkdir -p ./x64/Release
	$(CXX) $(CXXFLAGS) $(OPENCV_CXXFLAGS) $(CFITSIO_CXXFLAGS) -I"$(FITSSTACKER_DIR)" -Wno-unused-variable -Wno-unused-function -MF"$(@:%.o=%.d)" -o"$@" "$<"
	@echo ' '

./x64/Release/gp_%.o: $(GP_DIR)/gp_%.cpp
	@mkdir -p ./x64/Release
	$(CXX) $(GP_CXXFLAGS) -Wno-unused-variable -Wno-unused-function -MF"$(@:%.o=%.d)" -o"$@" "$<"
	@echo ' '

./x64/Release/galaxy_processor_main.o: $(GP_DIR)/galaxy_processor_main.cpp
	@mkdir -p ./x64/Release
	$(CXX) $(GP_CXXFLAGS) -Wno-unused-variable -Wno-unused-function -MF"$(@:%.o=%.d)" -o"$@" "$<"
	@echo ' '

./x64/Release/moc_gp_gui.cpp: $(GP_DIR)/gp_gui.h
	@mkdir -p ./x64/Release
	$(MOC) $(GP_DIR)/gp_gui.h -o $@
	@echo "MOC: gp_gui.h"

./x64/Release/moc_gp_gui.o: ./x64/Release/moc_gp_gui.cpp
	$(CXX) $(GP_CXXFLAGS) -Wno-unused-variable -Wno-unused-function -o"$@" "$<"
	@echo ' '

#
# Common rules
#

.PHONY: clean
clean:
	rm -f ./x64/Release/test_fft.o ./x64/Release/test_fft.d $(OBJ_DIR)/test_fft
	rm -f ./x64/Release/test_bgextraction.o ./x64/Release/test_bgextraction.d $(OBJ_DIR)/test_bgextraction
	rm -f ./x64/Release/test_stretch.o ./x64/Release/test_stretch.d $(OBJ_DIR)/test_stretch
	rm -f ./x64/Release/test_realdata.o ./x64/Release/test_realdata.d $(OBJ_DIR)/test_realdata
	rm -f ./x64/Release/xisf_wcs.o ./x64/Release/xisf_wcs.d $(OBJ_DIR)/xisf_wcs
	rm -f ./x64/Release/xisf_snr.o ./x64/Release/xisf_snr.d $(OBJ_DIR)/xisf_snr
	rm -f $(GP_OBJ) $(GP_OBJ:.o=.d) $(OBJ_DIR)/galaxy_processor
	rm -f ./x64/Release/stackengine_cli.o ./x64/Release/stackengine_cli.d

.PHONY: solve
solve:
	cd ../.. && bash solve_and_cache.sh

.PHONY: run
run: all
	$(OBJ_DIR)/test_fft
	$(OBJ_DIR)/test_bgextraction
	$(OBJ_DIR)/test_stretch
	$(OBJ_DIR)/test_realdata --save-reference

# galaxy_processor module compile rules are above via GP_OBJ pattern rules

./x64/Release/%.o: ../../%.cpp
	@mkdir -p ./x64/Release
	$(CXX) $(CXXFLAGS) -I"$(BG_SRC_DIR)" -I"$(LHE_SRC_DIR)" -I"$(PCLSRCDIR)/modules/file-formats" -MF"$(@:%.o=%.d)" -o"$@" "$<"
	@echo ' '
