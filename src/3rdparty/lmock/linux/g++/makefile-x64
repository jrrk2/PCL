######################################################################
# PCL Mock Library
# Platform: Linux/g++ x64
######################################################################

OBJ_DIR="x64/Release"

.PHONY: all
all: $(OBJ_DIR)/libMock-pxi.a

#
# Source files
#

SRC_FILES= \
../../FITS.cpp \
../../PCLMockAPI.cpp \
../../PCLMockImageWindow.cpp \
../../PCLThreadMock.cpp \
../../QtUiExporter.cpp \
../../LuaScriptExporter.cpp \
../../MockMain.cpp \
../../PCLInterfaceScanner.cpp \
../../ImageReader.cpp \

#
# Object files
#

OBJ_FILES= \
./x64/Release/PCLMockAPI.o \
./x64/Release/PCLMockImageWindow.o \
./x64/Release/PCLThreadMock.o \
./x64/Release/QtUiExporter.o \
./x64/Release/LuaScriptExporter.o \
./x64/Release/MockMain.o \
./x64/Release/PCLInterfaceScanner.o \
./x64/Release/ImageReader.o \

#
# Dependency files
#

DEP_FILES= \
./x64/Release/PCLMockAPI.d \
./x64/Release/PCLMockImageWindow.d \
./x64/Release/PCLThreadMock.d \
./x64/Release/QtUiExporter.d \
./x64/Release/LuaScriptExporter.d \
./x64/Release/MockMain.d \
./x64/Release/PCLInterfaceScanner.d \
./x64/Release/ImageReader.d \

#
# Rules
#

-include $(DEP_FILES)

$(OBJ_DIR)/libMock-pxi.a: $(OBJ_FILES)
	ar rc $@ $(OBJ_FILES)
	cp -p $@ $(PCLLIBDIR64)

.PHONY: clean
clean:
	rm -f $(OBJ_FILES) $(DEP_FILES) $(OBJ_DIR)/libMock-pxi.a

# Create the x64/Release directory structure if it doesn't exist
./x64/Release:
	mkdir -p ./x64/Release

QT5_CXXFLAGS = $(shell pkg-config --cflags Qt5Core Qt5Widgets Qt5Gui Qt5Svg 2>/dev/null)

# Make sure the directory exists before compiling
./x64/Release/%.o: ../../%.cpp | ./x64/Release
	g++ -g -O0 -c -pipe -pthread -m64 -fmax-errors=1000 -fno-omit-frame-pointer -fPIC -D_REENTRANT -D__PCL_LINUX -D__PCL_NO_PERFORMANCE_CRITICAL_MATH_ROUTINES -I"$(PCLINCDIR)" -I"$(PCLSRCDIR)/3rdparty" -I"$(PCLSRCDIR)/modules/file-formats" $(QT5_CXXFLAGS) -ffunction-sections -fdata-sections -fvisibility=hidden -fvisibility-inlines-hidden -std=c++17 -Wall -Wno-parentheses -MMD -MP -MF"$(@:%.o=%.d)" -o"$@" "$<"
	@echo ' '
